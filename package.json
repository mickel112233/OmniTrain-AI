{
  "name": "omnitrain-ai-pro",
  "version": "1.0.0",
  "description": "Production-grade Universal AI Training Studio",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:electron\"",
    "dev:frontend": "vite frontend",
    "dev:backend": "python3 backend/main.py",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "build": "npm run build:frontend && npm run build:electron && electron-builder",
    "build:frontend": "vite build frontend",
    "build:electron": "tsc -p tsconfig.electron.json",
    "test": "vitest run && pytest backend/tests"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "clsx": "^2.0.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-flow-renderer": "^10.3.17",
    "tailwind-merge": "^2.1.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.7",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.omnitrain.pro",
    "productName": "OmniTrain AI Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-electron/**/*",
      "dist-frontend/**/*",
      "backend/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "frontend/public/icon.ico"
    }
  }
}
