{
  "name": "omnitrain-ai",
  "version": "0.1.0",
  "description": "Universal AI Training Studio",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dist": "electron-builder"
  },
  "keywords": [
    "AI",
    "Training",
    "Machine Learning",
    "Electron",
    "Universal"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.omnitrain.ai",
    "productName": "OmniTrain AI",
    "files": [
      "app/**/*",
      "backend/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "app/assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "axios": "^1.6.2"
  }
}
